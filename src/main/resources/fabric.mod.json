{
  "schemaVersion": 1,
  "id": "swiftclient",
  "version": "1.0.9",
  "name": "Swift Client Mod",
  "description": "Swift Client - High-performance, modern & lightweight PvP client",
  "authors": [
    "Swift Client Team"
  ],
  "contact": {
    "homepage": "https://swiftclient.dev"
  },
  "license": "ARR",
  "icon": "assets/swiftclient/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.swiftclient.SwiftClient"
    ]
  },
  "mixins": [
    {
      "config": "swiftclient.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.18.4",
    "fabric-resource-loader-v0": "*",
    "fabric-command-api-v2": "*",
    "fabric-lifecycle-events-v1": "*",
    "minecraft": ">=26.2 <26.3",
    "java": ">=25",
    "geckolib": ">=5.5"
  },
  "jars": [
    {
      "file": "META-INF/jars/ferrite-core-9.0.0-fabric.jar"
    },
    {
      "file": "META-INF/jars/geckolib-7gaQHok7.jar"
    },
    {
      "file": "META-INF/jars/immediatelyfast-1.16.4+26.2-fabric.jar"
    },
    {
      "file": "META-INF/jars/lithium-mc26.2-0.25.3-fabric.jar"
    },
    {
      "file": "META-INF/jars/sodium-mc26.2-0.9.2-fabric.jar"
    }
  ]
}