{
  "schemaVersion": 1,
  "id": "swiftclient",
  "version": "${version}",
  "name": "Swift Client Mod",
  "description": "Swift Client - High-performance, modern & lightweight PvP client",
  "authors": [
    "Swift Client Team"
  ],
  "contact": {
    "homepage": "https://swiftclient.dev"
  },
  "license": "ARR",
  "icon": "assets/swiftclient/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.swiftclient.SwiftClient"
    ]
  },
  "mixins": [
    {
      "config": "swiftclient.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.18.4",
    "minecraft": ">=26.2 <26.3",
    "java": ">=25",
    "fabric-api": ">=0.161.0",
    "fabric-resource-loader-v0": "*",
    "fabric-command-api-v2": "*",
    "fabric-lifecycle-events-v1": "*",
    "geckolib": ">=5.5"
  }
}
